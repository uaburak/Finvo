rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // !!! DİKKAT: BU KURALLAR SADECE TEST İÇİNDİR !!!
    // HERKES OKUYABİLİR VE YAZABİLİR.
    
    match /invites/{inviteId} {
      allow read, write: if true;
    }

    match /permission_requests/{requestId} {
      allow read, write: if true;
    }
    
    // Kullanıcılar
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Cüzdanlar (ve alt koleksiyonları)
    match /wallets/{walletId} {
      allow read, write: if true;
      
      match /transactions/{transactionId} {
        allow read, write: if true;
      }
    }
  }
}
